{
  "name": "TickerBands (mock-mode demo)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "containerEnv": {
    "TICKERBANDS_MOCK": "1",
    "TICKERBANDS_NO_KEYRING": "1",
    "TICKERBANDS_NO_OPEN": "1",
    "TICKERBANDS_DEMO": "1"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "./run_app.sh",
  "forwardPorts": [
    5174
  ],
  "portsAttributes": {
    "5174": {
      "label": "TickerBands (open this)",
      "onAutoForward": "openBrowser"
    },
    "8001": {
      "label": "API (internal)",
      "onAutoForward": "silent"
    }
  }
}
