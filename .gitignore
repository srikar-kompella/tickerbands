# Personal data — never to a remote (ROOT-anchored: the unanchored form
# also matched frontend/src/components/discussions/ and silently kept the
# discussion UI components out of the public repo — CI run #1 caught it)
/discussions/
!/discussions/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets / tokens (belt-and-suspenders; token lives outside the repo anyway)
.env
*token*.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
dist/

# OS / editor
.DS_Store
*.log

# Local AI-session settings (per-machine)
.claude/
